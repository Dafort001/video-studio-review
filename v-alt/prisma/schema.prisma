// -----------------------------------------------------------------------------
// PIPELINE RESULTS — Verarbeitete/entwickelte Bilder aus Modal
// -----------------------------------------------------------------------------

model ProcessedImage {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Herkunft (Verknüpfung mit Original-Upload)
  captureId    String? // captureId aus UploadFile
  sourceFileId String? // UploadFile.fileId (Original)

  // R2 Storage
  r2ObjectKey            String // Finales Bild (JPG/TIF) in R2
  thumbKey               String? // Thumbnail-Key in R2 (optional, kleinere Version)
  depthMapKey            String? // Tiefenkarte-Key in R2 (aus Depth-Anything)
  editorMasterKey        String? // Unveraenderte Editor-Rueckgabe in voller Aufloesung
  qcVariantKey           String? // Aktuell gewaehlter QC-/Crop-/Photoshop-Stand
  deliveryKey            String? // Operative 3000-px-Delivery-Version
  deliveryWidth          Int?
  deliveryHeight         Int?
  deliveryFileSizeBytes  BigInt?
  deliveryVersion        Int     @default(1)
  parentProcessedImageId String? // Ursprung bei versionierten Varianten
  variantLabel           String? // Original, Crop, Photoshop, KI usw.

  // Bild-Metadaten
  roomType       String?
  roomName       String? // Deutsch, z. B. "Wohnzimmer"
  floor          String? // "EG", "OG1" etc.
  motifIndex     Int?
  width          Int? // px
  height         Int? // px
  fileSizeBytes  BigInt?
  finalRoomType  String?
  finalRoomName  String?
  finalFloor     String?
  finalMotifName String?
  finalFilename  String?

  // KI-Ausgaben
  altText    String? @db.Text // Qwen-generierter Kurztext fuer Alt/SEO, maximal 200 Zeichen
  exposeText String? @db.Text // Qwen-generierte laengere Bildbeschreibung fuer Exposee-Vorbereitung
  aiOverlays Json? // { boxes: [...], masks: [...], labels: [...] } — YOLO/SAM3 Ergebnisse

  // Bearbeitungs-Einstellungen (vom Admin oder Kunden wählbar)
  stylePreset   String @default("natural_hdr") // natural_hdr | flambient | sunny_bright | pure | editorial | classic
  windowPreset  String @default("auto") // auto | blend | replace | clear
  skyPreset     String @default("none") // none | blue | twilight | cloudy | dramatic
  cleaningFlags Json? // { denoise_floor: bool, denoise_wall: bool, correct_vertical: bool, remove_cables: bool, remove_plumbing: bool }

  // Manuelle Masken-Korrekturen (für Pipeline Re-Run)
  annotations Json? // Canvas-Pfade vom AnnotationOverlay-Editor

  // Admin QC
  qcNote          String?   @db.Text // Admin-Kommentar bei Ablehnung oder Revision
  qcStatus        String    @default("qc_pending") // qc_pending, qc_working, qc_needs_revision, qc_rejected, qc_approved, delivery_ready
  qcApprovedAt    DateTime?
  deliveryReadyAt DateTime?
  qcMetadata      Json?

  // Status-Lifecycle
  // ready → re_processing → pending_edit → approved → downloaded
  status String @default("ready")

  // Kunden-Bearbeitungsaufträge (Galerie 2 Editing-Panel)
  editRequests       ImageEditRequest[]
  // Privates Gesamtmanifest aller nicht-destruktiven KI-Versionen.
  editManifest       Json?
  editManifestKey    String?
  editManifestSha256 String?             @db.VarChar(64)
  galleryLabelAssets GalleryLabelAsset[]
  // Review-Galerie Bewertungen
  reviews            ImageReview[]

  // V2 Naming Spec: Versionierte Outputs unter diesem stabilen Workflow-Anker
  captureOutputs         PixcaptureCaptureOutput[]
  currentCaptureOutputId String? // Schneller Zeiger auf die aktuelle Output-Version

  // Kunden-Freigabe
  isApproved      Boolean @default(false)
  isDownloaded    Boolean @default(false)
  customerNote    String? @db.Text // Kommentar des Kunden zum Bild
  customerRating  String? // GREEN | YELLOW | RED
  exposeSortOrder Int? // Reihenfolge im Exposé (1 = Startbild, 2, 3, ...)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([jobId, status])
  @@index([jobId, qcStatus])
  @@index([deliveryKey])
  @@index([captureId])
}

// -----------------------------------------------------------------------------
// EDITING REQUESTS — Kunden-initiierte Bildbearbeitungen (Galerie 2)
// -----------------------------------------------------------------------------

model ImageEditRequest {
  id               String         @id @default(cuid())
  processedImageId String
  processedImage   ProcessedImage @relation(fields: [processedImageId], references: [id], onDelete: Cascade)

  // Was soll getan werden?
  actionType       String // remove_object | replace_object | adjust | custom
  prompt           String  @db.Text
  standardPromptId String? // z. B. "remove_cables", "swap_bedding", ...

  // Masken-Daten: Canvas-Pfade + ausgewählte AI-Masken-Labels
  maskData Json? // { paths, arrows, selectedMasks, width, height }

  // Lifecycle
  // pending → processing → done | failed
  status String @default("pending")

  // Wiederholungssteuerung: 1 Original + max. 2 Wiederholungen = 3 Versuche
  attemptNumber Int @default(1) // Aktueller Versuch (1–3)
  maxAttempts   Int @default(3)

  // Nicht-destruktive Versionskette
  parentRequestId     String?
  inputImageKey       String?
  inputSha256         String? @db.VarChar(64)
  resultImageKey      String?
  resultFilename      String?
  resultMimeType      String?
  resultWidth         Int?
  resultHeight        Int?
  resultFileSizeBytes BigInt?
  resultSha256        String? @db.VarChar(64)

  // Private Provider- und Laufdaten
  provider              String?
  model                 String?
  providerRequestId     String?
  providerRawSha256     String?   @db.VarChar(64)
  promptSha256          String?   @db.VarChar(64)
  promptTemplateVersion String?
  durationMs            Int?
  startedAt             DateTime?
  completedAt           DateTime?

  // Optionaler Wirkbereich und Referenzbild
  maskImageKey      String?
  maskSha256        String? @db.VarChar(64)
  referenceImageKey String?
  referenceFilename String?
  referenceSha256   String? @db.VarChar(64)

  // Qwen beschreibt jede erfolgreiche Variante erneut
  altText            String?   @db.Text
  altTextStatus      String    @default("pending")
  altTextModel       String?
  altTextConfidence  Float?
  altTextCompletedAt DateTime?

  provenance Json?

  // Abrechnung (Platzhalter — Preis noch nicht festgelegt)
  priceCents          Int? // z. B. 199 = 1,99 €
  isPaid              Boolean @default(false)
  billingKind         String?
  billingRedemptionId String?

  // Fehlerprotokoll
  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processedImageId])
  @@index([processedImageId, status])
  @@index([parentRequestId])
}

