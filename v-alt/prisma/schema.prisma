// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// NEXTAUTH MODELS
// -----------------------------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  hashedPassword     String? // Added for Credentials Provider
  image              String?
  role               String    @default("customer") // customer, admin
  isApproved         Boolean   @default(false) // Must be manually approved by admin
  mobileConnectToken String?   @unique // Secret long-lived token for iOS App Camera authentication

  // Custom PixCapture Fields
  customerId   String? @unique @db.VarChar(3) // The 3-letter Base36 code (cust3), e.g., 'A9F'
  stripeCustId String? @unique
  priceTier    String  @default("standard") // standard, pro, enterprise

  // B2B Contact Fields
  companyName              String?
  phone                    String?
  phoneVerified            Boolean   @default(false)
  phoneVerificationCode    String?
  phoneVerificationExpires DateTime?
  street                   String?
  houseNumber              String?
  postalCode               String?
  city                     String?
  country                  String?
  vatId                    String? // Steuernummer / USt-IdNr.
  website                  String? // Firmen-Webseite (optional)

  // Mobile App Access
  pixcaptureEnabled         Boolean   @default(false) // Must be enabled for mobile app login
  isSuspended               Boolean   @default(false)
  isDeleted                 Boolean   @default(false)
  mobileCodeHash            String? // Hashed 6-digit code for mobile auth
  mobileCodeExpires         DateTime? // Code expiry (10 min)
  mobileCodeAttempts        Int       @default(0) // Failed verification attempts
  mobileCodeLastRequestedAt DateTime? // Rate limiting: last code request timestamp

  // DSGVO Compliance
  privacyConsentAt DateTime? // Timestamp when user accepted privacy policy

  accounts           Account[]
  sessions           Session[]
  jobs               Job[]
  piximmoBookings    PiximmoBooking[]
  piximmoAddonOrders PiximmoAddonOrder[]
  accountInvitations CustomerAccountInvitation[]
  globalPrefs        GlobalPreferences?
  notifications      Notification[]
  videoStudioBrandAssets VideoStudioBrandAsset[]
  videoStudioFontAssets  VideoStudioFontAsset[]
  videoStudioPresets     VideoStudioPreset[]

  // Billing
  trialUsed             Boolean                @default(false) // Whether the user already used the trial package
  aiEditTrialUsedAt     DateTime? // Productübergreifend einmaliger kostenloser AI-Playground-Durchgang
  aiEditTrialRequestId  String?                @unique // Erster Request des eingelösten Durchgangs
  aiEditPaymentMethod   String                 @default("stripe") // stripe | invoice (nur nach ausdrücklicher Admin-Freigabe)
  aiEditCodeRedemptions AiEditCodeRedemption[]
  invoices              Invoice[]
  creditBalance         CreditBalance?
  creditTransactions    CreditTransaction[]
}

model VideoStudioBrandAsset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String   @unique @db.Text
  filename   String
  mimeType   String
  width      Int
  height     Int
  sizeBytes  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isActive])
}

model VideoStudioPreset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       String
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, kind, name])
  @@index([userId, kind])
}

model VideoStudioFontAsset {
  id                   String   @id
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey           String   @unique @db.Text
  displayName          String
  filename             String
  mimeType             String
  sizeBytes            Int
  rightsConfirmedAt    DateTime
  licenseReference     String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, updatedAt])
}

model CustomerAccountInvitation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AiEditAccessCode {
  id         String   @id @default(cuid())
  code       String   @unique
  weekKey    String   @unique
  validFrom  DateTime
  expiresAt  DateTime
  maxResults Int      @default(5)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  redemptions AiEditCodeRedemption[]

  @@index([active, expiresAt])
}

model AiEditCodeRedemption {
  id               String           @id @default(cuid())
  accessCodeId     String
  accessCode       AiEditAccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  remainingResults Int
  reservedResults  Int              @default(0)
  consumedResults  Int              @default(0)
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([accessCodeId, userId])
  @@index([userId, expiresAt])
}

model VideoWorkbenchProject {
  id             String   @id @default(cuid())
  projectId      String   @unique
  title          String
  candidateIndex Int?
  candidateLabel String?
  ownerProducts  Json
  sections       Json
  lastWriter     Json?
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PIXCAPTURE CORE MODELS
// -----------------------------------------------------------------------------

model GlobalPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultStyle    String @default("standard")
  defaultWindow   String @default("clear")
  defaultDelivery String @default("jpg,tif_base")
}

model Job {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The V1 Standard Identifier
  customerCode String @db.VarChar(3) // cust3 from user
  jobId        String @db.VarChar(5) // unique job5 code per job

  projectName     String? // Optional visual label, e.g. "Sonnenallee"
  propertyAddress String? // Added for PixCapture Mobile App UI representation
  contactName     String? // Ansprechpartner innerhalb eines Firmenkunden, z.B. Haferkamp -> Anja Roberts
  notes           String? @db.Text // Optional notes sent from Mobile App

  // Job Lifecycle: pending_upload -> style_selection -> pending_payment -> processing -> completed
  status                     String    @default("pending_upload")
  paymentStatus              String    @default("unpaid") // unpaid, paid, failed
  sourceProduct              String    @default("pixcapture") @db.VarChar(24) // pixcapture | piximmo
  sourceChannel              String    @default("pixcapture_portal") @db.VarChar(32) // admin/customer/mobile origin within sourceProduct
  analysisStatus             String    @default("not_started") @db.VarChar(32) // not_started | running | completed | partial | failed
  analysisRunId              String?
  analysisStages             Json?
  analysisExpectedCount      Int       @default(0)
  analysisProcessedCount     Int       @default(0)
  analysisFailedCount        Int       @default(0)
  analysisEstimatedCostCents Int       @default(0)
  analysisStartedAt          DateTime?
  analysisCompletedAt        DateTime?
  analysisError              String?   @db.Text

  // --- Order Configuration (ImageLife Workflow) ---
  selectedStyleId    Int? // 1 to 5 (1-4 Automated, 5 Personal Editor)
  styleModifiers     Json? // Stores user selections (e.g. { "windowMode": "clear" })
  editorInstructions String? @db.Text // Specific text instructions for Style 5 (Personal Editor)
  selectedFileCount  Int? // Number of images chosen for processing in Gallery check

  // Immutable PixImmo order contract. Null for PixCapture and legacy jobs.
  piximmoProcessingMode          String?   @db.VarChar(16) // ki | manuell
  piximmoIncludedImageCount      Int?
  piximmoPricingCatalogVersion   String?   @db.VarChar(16)
  piximmoPricingSnapshot         Json?
  piximmoFirstCustomerDownloadAt DateTime?
  piximmoInvoiceScheduledFor     DateTime?
  piximmoInvoiceScheduleReason   String?   @db.VarChar(32) // first_download | release_fallback | later_download

  // Telemetry & Cost Tracking
  computeCostCents Int @default(0) // Modal CPU/GPU cost
  apiCostCents     Int @default(0) // Replicate, FAL, OpenAI cost
  totalCostCents   Int @default(0) // Pre-calculated total for dashboard 

  // Grundriss-PDF (vom Telefon via App hochgeladen)
  floorPlanKey String? // R2-Key für Grundriss-PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadSessions           UploadSession[]
  captures                 Capture[]
  exposee                  ExposeePackage?
  exposeePublicLinks       ExposeePublicLink[]
  processedImages          ProcessedImage[]
  galleryShares            GalleryShare[]
  pixcaptureCaptures       PixcaptureCapture[] // V2 Naming Spec
  imageLifeOrders          ImageLifeOrder[]
  invoices                 Invoice[]
  piximmoBooking           PiximmoBooking?
  piximmoGallerySelections PiximmoGallerySelection[]
  piximmoAddonOrders       PiximmoAddonOrder[]
  piximmoMileageTrips      PiximmoMileageTrip[]
  videoStudioSourceSets        VideoStudioSourceSet[]
  activeVideoStudioSourceSetId String?                   @unique
  activeVideoStudioSourceSet   VideoStudioSourceSet?     @relation("ActiveVideoStudioSourceSet", fields: [activeVideoStudioSourceSetId], references: [id], onDelete: SetNull)

  @@unique([customerCode, jobId])
}

/// Immutable, versioned source manifest for one Video Studio job. The JSON
/// payload is verified against snapshotDigest whenever it is read; activation
/// is an independent pointer on Job so an incomplete import can never replace
/// the current source set.
model VideoStudioSourceSet {
  id                String   @id @default(cuid())
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  schemaVersion     String   @db.VarChar(48)
  manifestDigest    String   @db.VarChar(64)
  snapshotDigest    String   @db.VarChar(64)
  sourceReferenceId String   @unique @db.VarChar(120)
  assetCount        Int
  entries           Json
  createdAt         DateTime @default(now())

  activeForJob Job? @relation("ActiveVideoStudioSourceSet")

  @@unique([jobId, manifestDigest])
  @@unique([id, jobId])
  @@index([jobId, createdAt])
}

// -----------------------------------------------------------------------------
// IMAGELIFE PROVIDER HANDOFF / RETURN
// -----------------------------------------------------------------------------

/// Stable internal parent for one provider submission. The human-readable
/// reference is deliberately not unique; provider order and batch IDs carry
/// the immutable external identity once ImageLife has accepted the order.
model ImageLifeOrder {
  id                      String    @id @default(cuid())
  jobId                   String
  job                     Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceProduct           String    @db.VarChar(24) // piximmo | pixcapture
  sourceChannel           String    @db.VarChar(32)
  transferInstanceId      String    @unique
  humanReference          String    @db.VarChar(160)
  providerOrderId         String?   @unique @db.VarChar(64)
  section                 String    @db.VarChar(24)
  status                  String    @default("prepared") @db.VarChar(32)
  expectedSourceFileCount Int
  expectedOutputCount     Int
  sourceManifest          Json
  sourceManifestSha256    String    @db.VarChar(64)
  providerAcceptedAt      DateTime?
  providerCompletedAt     DateTime?
  lastSignalAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  batches       ImageLifeBatch[]
  inboundEvents ImageLifeInboundEvent[]

  @@index([jobId])
  @@index([sourceProduct, status])
  @@index([humanReference, status])
}

model ImageLifeBatch {
  id                String         @id @default(cuid())
  orderId           String
  order             ImageLifeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerBatchId   String         @unique @db.VarChar(64)
  productName       String?
  quantity          Int?
  uploadedFileCount Int?
  status            String         @default("accepted") @db.VarChar(32)
  archiveR2Key      String?        @unique @db.Text
  archiveSizeBytes  BigInt?
  archiveEtag       String?
  archiveSha256     String?        @db.VarChar(64)
  returnManifest    Json?
  downloadedAt      DateTime?
  reconciledAt      DateTime?
  quarantineReason  String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  inboundEvents ImageLifeInboundEvent[]
  returnFiles   ImageLifeReturnFile[]

  @@index([orderId])
  @@index([status])
}

/// Metadata-only audit record. Full mail bodies and confidential provider
/// download URLs are intentionally never stored here.
model ImageLifeInboundEvent {
  id              String          @id @default(cuid())
  webhookEventId  String          @unique @db.VarChar(160)
  resendEmailId   String          @unique @db.VarChar(160)
  messageId       String?
  fromAddress     String
  recipients      Json
  subject         String          @db.Text
  classification  String          @db.VarChar(32)
  status          String          @default("received") @db.VarChar(32)
  providerOrderId String?         @db.VarChar(64)
  providerBatchId String?         @db.VarChar(64)
  humanReference  String?         @db.VarChar(160)
  errorMessage    String?         @db.Text
  orderId         String?
  order           ImageLifeOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  batchId         String?
  batch           ImageLifeBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([classification, status])
  @@index([providerOrderId])
  @@index([providerBatchId])
}

model ImageLifeReturnFile {
  id                       String         @id @default(cuid())
  batchId                  String
  batch                    ImageLifeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  providerFilename         String
  r2ObjectKey              String         @unique @db.Text
  sizeBytes                BigInt
  checksumSha256           String?        @db.VarChar(64)
  crc32                    String?        @db.VarChar(16)
  sourceStackKey           String?
  status                   String         @default("stored") @db.VarChar(32)
  version                  Int            @default(1)
  importedProcessedImageId String?
  qwenStatus               String         @default("pending") @db.VarChar(24)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([batchId, providerFilename])
  @@index([batchId, status])
  @@index([qwenStatus])
}

model PiximmoBooking {
  id            String @id @default(cuid())
  bookingNumber String @unique @db.VarChar(24)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sourceSystem     String    @default("piximmo") @db.VarChar(32)
  sourceReference  String?   @unique @db.VarChar(128)
  legacyImportedAt DateTime?

  jobId String? @unique
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  customerCode          String? @db.VarChar(3)
  status                String  @default("confirmed") // confirmed | cancelled
  bookingKind           String  @default("property") @db.VarChar(24) // property | drone_solo
  processingMode        String? @db.VarChar(16) // ki | manuell; null only on legacy bookings
  additionalUnits       Int     @default(0)
  droneIncluded         Boolean @default(false)
  includedImageCount    Int     @default(15)
  pricingCatalogVersion String  @default("2026-08-01") @db.VarChar(16)
  pricingSnapshot       Json?

  projectName     String
  propertyAddress String
  propertyType    String?

  street           String?
  houseNumber      String?
  postalCode       String?
  city             String?
  country          String  @default("Deutschland")
  formattedAddress String?
  addressLat       String?
  addressLng       String?
  addressPlaceId   String?

  requestedDate   String   @db.VarChar(10)
  requestedTime   String   @db.VarChar(5)
  durationMinutes Int
  slotStartAt     DateTime
  slotEndAt       DateTime

  contactName   String?
  contactEmail  String?
  contactPhone  String?
  onSiteContact String?

  accessDetails       String? @db.Text
  specialRequirements String? @db.Text
  sunPreference       String?

  services      Json
  subtotalCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int    @default(0)
  currency      String @default("EUR") @db.VarChar(3)
  paymentStatus String @default("invoice_open") @db.VarChar(24) // invoice_open | invoice_draft | invoiced | paid | cancelled

  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?   @db.Text
  confirmationSmsSentAt   DateTime?
  confirmationSmsError    String?   @db.Text
  calendarInviteSentAt    DateTime?
  calendarInviteError     String?   @db.Text

  mileageTrips PiximmoMileageTrip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, requestedDate])
  @@index([requestedDate, requestedTime])
}

model PiximmoMileageTrip {
  id        String @id @default(cuid())
  sourceKey String @unique @db.VarChar(160)

  sourceSystem String          @default("piximmo") @db.VarChar(32)
  bookingId    String?
  booking      PiximmoBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  jobId        String?
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)

  tripDate  String @db.VarChar(10)
  sequence  Int
  direction String @db.VarChar(24) // outbound | between | return | manual

  startedAt DateTime?
  endedAt   DateTime?

  originLabel        String
  originAddress      String
  destinationLabel   String
  destinationAddress String
  purpose            String
  businessPartner    String?

  status          String   @default("draft") @db.VarChar(24) // draft | confirmed | locked | superseded
  distanceKm      Decimal? @db.Decimal(9, 2)
  distanceSource  String?  @db.VarChar(32) // google_directions | straight_line | odometer | manual
  durationMinutes Int?
  odometerStartKm Decimal? @db.Decimal(10, 1)
  odometerEndKm   Decimal? @db.Decimal(10, 1)
  routeSnapshot   Json?

  importedAt  DateTime?
  confirmedAt DateTime?
  confirmedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  revisions PiximmoMileageRevision[]

  @@index([tripDate, sequence])
  @@index([status, tripDate])
  @@index([bookingId])
  @@index([jobId])
}

model PiximmoMileageRevision {
  id     String             @id @default(cuid())
  tripId String
  trip   PiximmoMileageTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  version      Int
  changedAt    DateTime @default(now())
  changedBy    String?
  changeReason String?  @db.Text
  snapshot     Json

  @@unique([tripId, version])
  @@index([changedAt])
}

model PiximmoAddonOrder {
  id          String @id @default(cuid())
  orderNumber String @unique @db.VarChar(24)

  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         String    @default("draft") @db.VarChar(24) // draft | confirmed | invoice_draft | invoiced | paid | cancelled
  productScope   String    @default("gallery") @db.VarChar(24)
  catalogVersion String    @db.VarChar(16)
  subtotalCents  Int
  taxCents       Int
  totalCents     Int
  currency       String    @default("EUR") @db.VarChar(3)
  confirmedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines      PiximmoAddonOrderLine[]
  selections PiximmoGallerySelection[]

  @@index([jobId, status])
  @@index([userId, createdAt])
}

model PiximmoAddonOrderLine {
  id      String            @id @default(cuid())
  orderId String
  order   PiximmoAddonOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productCode       String   @db.VarChar(32)
  motifKey          String?  @db.Text
  description       String
  quantity          Int      @default(1)
  unitPriceNetCents Int
  lineNetCents      Int
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([productCode])
}

model PiximmoGallerySelection {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  motifKey          String    @db.Text
  processedImageId  String?
  entitlementKind   String    @db.VarChar(16) // included | goodwill | extra
  status            String    @default("selected") @db.VarChar(24) // selected | payment_pending | purchased | processing | delivery_ready | removed
  unitPriceNetCents Int       @default(0)
  selectedAt        DateTime  @default(now())
  confirmedAt       DateTime?
  removedAt         DateTime?

  addonOrderId String?
  addonOrder   PiximmoAddonOrder? @relation(fields: [addonOrderId], references: [id], onDelete: SetNull)

  @@unique([jobId, motifKey])
  @@index([jobId, status])
  @@index([addonOrderId])
}

model PiximmoBookingHold {
  id              String   @id @default(cuid())
  tokenHash       String   @unique @db.VarChar(64)
  activeSlotKey   String?  @unique @db.VarChar(32)
  status          String   @default("active") @db.VarChar(16) // active | consumed | released | expired
  requestedDate   String   @db.VarChar(10)
  requestedTime   String   @db.VarChar(5)
  durationMinutes Int      @default(90)
  expiresAt       DateTime
  claimedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, requestedDate, expiresAt])
  @@index([requestedDate, requestedTime])
}

model UploadSession {
  id    String  @id @default(cuid())
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sessionId String @unique // e.g. "sess_abcd123" (used in Web Connect & API)

  // V1 WebApp/Backend Contract Fields
  shootId    String?
  shoot      Shoot?  @relation(fields: [shootId], references: [id], onDelete: Cascade)
  customerId String?

  type   String @default("DIRECT_R2") // LOCAL_WIFI, DIRECT_R2
  status String @default("created") // created, pending, connected, uploading, complete_staged, committed, failed, expired, finalized

  transferTokenHash String?
  expiresAt         DateTime?

  filesExpected Int    @default(0)
  filesReceived Int    @default(0)
  bytesExpected BigInt @default(0)
  bytesReceived BigInt @default(0)

  errorLog Json?

  manifest       Json? // The parsed UNIFIED_CAPTURE_DATA_HANDOFF_MANIFEST_V1
  totalSizeBytes BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files       UploadFile[]
  fileObjects FileObject[]
}

model Shoot {
  id            String @id @default(cuid()) // shoot_id
  customerId    String // index
  shootCode     String
  status        String @default("draft") // draft, uploading, staged, committed, failed
  schemaVersion String @default("upload-contract-v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadSessions UploadSession[]
  fileObjects    FileObject[]

  @@index([customerId])
}

model FileObject {
  id        String        @id @default(cuid()) // file_id
  sessionId String // FK
  session   UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  shootId String // FK
  shoot   Shoot  @relation(fields: [shootId], references: [id], onDelete: Cascade)

  kind         String // image, raw, arkit, meta
  relativePath String
  pathStaging  String
  pathFinal    String?

  sizeBytes BigInt
  sha256    String?

  status String @default("missing") // missing, uploaded, verified

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([shootId])
}

model UploadFile {
  id        String        @id @default(cuid())
  sessionId String
  session   UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  fileId String @unique // Internal ID from the manifest

  // Upload lifecycle: pending -> url_presigned -> uploaded -> merged -> canonical
  status String @default("pending")

  originalName   String
  canonicalName  String?
  r2ObjectKey    String?
  sizeBytes      BigInt?
