// =============================================================================
// NAMING SPEC V2 — Capture/Frame/Output Hierarchie
// =============================================================================

/// Ein Motiv (= ein Kamerstandpunkt/eine Perspective). Nicht ein einzelnes Bild.
/// Mehrere Frames (Brackets) gehören zu einem Capture.
model PixcaptureCapture {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sourceSessionId String? // UploadSession.id (wenn über App)
  sourceCaptureId String // Idempotenter Client-Key, z.B. "cap_2d4c1c7b"

  floorId    String  @default("none") // FK floor_taxonomy.id — NOT NULL, "none" = kein Geschoss
  roomId     String // FK room_taxonomy.id — z.B. "living-room"
  viewId     String? // FK view_taxonomy.id — nullable während Cutover
  motifIndex Int? // Nullable bis Finalize, dann serverseitig vergeben

  captureType    String    @default("single_photo") // single_photo | bracketed_photo | panorama | video
  captureSubtype String? // dark_room_single etc. — Workflow-Hint
  capturedAt     DateTime?
  frameCount     Int       @default(1)

  // staged → pending_naming (kein viewId) → finalized | qc_failed → processing → ready
  status        String  @default("staged")
  canonicalStem String? // "abc-x7k2q-eg-living-room-wide-m01"

  // ── Quality Control ──────────────────────────────────────────────
  qcStatus    String    @default("pending") // pending | passed | failed | warning
  qcCheckedAt DateTime?
  qcErrors    Json? // [{ code, message, messageTech, severity, frameId? }]
  qcScore     Int? // 0-100 Qualitäts-Score

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  frames  PixcaptureCaptureFrame[]
  outputs PixcaptureCaptureOutput[]

  // Ingest-Unique: Ein Client-Capture-ID pro Job (idempotent)
  @@unique([jobId, sourceCaptureId])
  // Motif-Zählung Index (für MAX query bei Finalize)
  // Partial Unique Constraint wird via raw SQL Migration erstellt
  @@index([jobId, floorId, roomId, viewId])
  @@map("pixcapture_captures")
}

/// Quelldatei eines Motivs. Wird erst nach Upload-Verify aus UploadFile erzeugt.
/// UploadFile = Transportschicht (presign, checksum, retry)
/// CaptureFrame = fachlich validiertes Frame (nach verified)
model PixcaptureCaptureFrame {
  id        String            @id @default(cuid())
  captureId String
  capture   PixcaptureCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)

  sourceFileId     String? // UploadFile.fileId — Herkunft
  originalFilename String // "IMG_1234.DNG"
  storageKey       String // R2 Object Key (erst temp UUID, dann kanonisch)
  extension        String // "dng"
  mimeType         String?
  sizeBytes        BigInt?

  bracketIndex Int     @default(1) // 1-N, 1 bei Einzelbild
  bracketTotal Int     @default(1) // 1=Einzelbild, 3=3er-Bracket, 5=5er
  evValue      Float? // -2.0, 0.0, +2.0
  evToken      String? // "n2", "0", "p2"

  canonicalFilename String? // "abc-x7k2q-eg-living-room-wide-m01-b01-en2.dng"
  checksumSha256    String?

  // ── Quality Control ──────────────────────────────────────────────
  qcStatus     String  @default("pending") // pending | passed | failed | warning
  qcErrors     Json? // [{ code, message, severity }]
  fileVerified Boolean @default(false) // R2 HEAD bestätigt Existenz + Größe

  // ── Kamera-Sensordaten (aus EXIF-Sidecar) ─────────────────────
  exposureQualityState  String? // "good" | "warning" | "bad" — von Kamera
  sharpnessQualityState String? // "good" | "bad" — von Kamera
  sensorData            Json? // Vollständige Sidecar-Daten (levelAngle, histogram, etc.)

  createdAt DateTime @default(now())

  // Ein Frame-Index pro Capture
  @@unique([captureId, bracketIndex])
  @@index([captureId])
  @@map("pixcapture_capture_frames")
}

/// Versionierte Ableitung eines Motivs (merged, edited, web export, etc.)
/// ProcessedImage bleibt als stabiler Workflow-Anker für Reviews/Editing bestehen.
/// CaptureOutput ist das konkrete versionierte Artefakt darunter.
model PixcaptureCaptureOutput {
  id        String            @id @default(cuid())
  captureId String
  capture   PixcaptureCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)

  // Relation zur stabilen ProcessedImage-Identität
  processedImageId String?
  processedImage   ProcessedImage? @relation(fields: [processedImageId], references: [id], onDelete: SetNull)

  outputKind        String // "merged" | "edited" | "web" | "print" | "thumb"
  version           Int     @default(1) // v1, v2, v3
  extension         String // "jpg"
  storageKey        String // R2 Object Key
  canonicalFilename String? // "abc-x7k2q-eg-living-room-wide-m01-v1.jpg"

  createdAt DateTime @default(now())

  // Ein Output-Kind + Version pro Capture
  @@unique([captureId, outputKind, version])
  @@index([captureId])
  @@index([processedImageId])
  @@map("pixcapture_capture_outputs")
}

// =============================================================================
// KOSTEN-TRACKING — API-Nutzung und Kosten-Logging
// =============================================================================

model ApiUsageLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // ── Zuordnung ──
  jobId   String? // Zu welchem Job gehört der Call?
  imageId String? // Zu welchem Bild gehört der Call?
  userId  String? // Wer hat ausgelöst?

  // ── Service-Info ──
  provider  String // "gemini" | "modal" | "r2" | "openai" | "replicate"
  model     String? // "gemini-2.0-flash-exp" | "qwen-vl" | "sam3" | "da3"
  operation String // "edit" | "describe" | "expose" | "pipeline" | "depth" | "segment"

  // ── Messgrößen ──
  inputTokens  Int? // Input-Tokens (LLM)
  outputTokens Int? // Output-Tokens (LLM)
  inputImages  Int? // Anzahl eingehender Bilder
  outputImages Int? // Anzahl ausgehender Bilder
  durationMs   Int? // Laufzeit in Millisekunden

  // ── Kosten ──
  costCents     Int     @default(0) // Kosten in Cent (ganzzahlig)
  costEstimated Boolean @default(true) // true = geschätzt, false = von API bestätigt
  currency      String  @default("EUR")

  // ── Details ──
  status       String  @default("success") // "success" | "error" | "partial"
  errorMessage String? @db.Text
  metadata     Json? // Beliebige Zusatzinfos (Prompt-Länge, Resolution, etc.)

  @@index([jobId])
  @@index([imageId])
  @@index([provider])
  @@index([createdAt])
  @@index([userId])
  @@map("api_usage_logs")
}

// =============================================================================
// NUTZER-ANALYTICS — Session-Dauer, Feature-Nutzung
// =============================================================================

model UserActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // ── Zuordnung ──
  userId    String? // Login-User (null = anonym/Review-Link)
  sessionId String // Eindeutige Session-ID (UUID vom Client)
  jobId     String? // Falls in einem Job-Kontext

  // ── Event ──
  event  String // "page_view" | "gallery_open" | "image_click" | "rating" | "comment"
  // "expose_select" | "download" | "edit_start" | "edit_submit"
  // "measure_tool" | "annotation_draw" | "csv_export" | "zip_download"
  // "session_start" | "session_end"
  page   String? // z. B. "/results/abc123", "/dashboard/galleries"
  target String? // z. B. imageId, jobId, button name
  value  String? // z. B. Rating-Wert, Prompt-Text (gekürzt)

  // ── Session-Messung ──
  durationMs Int? // Verweildauer auf der Seite/Session (in ms)

  // ── Geräte-Info (anonymisiert) ──
  deviceType String? // "desktop" | "mobile" | "tablet"
  userAgent  String? // Gekürzt, keine Fingerprinting-Daten

  @@index([userId])
  @@index([sessionId])
  @@index([event])
  @@index([createdAt])
  @@index([jobId])
  @@map("user_activity_logs")
}

// -----------------------------------------------------------------------------
// BILLING & INVOICING
// -----------------------------------------------------------------------------

model Invoice {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  jobId  String?
  job    Job?    @relation(fields: [jobId], references: [id])

  invoiceNumber   String  @unique // e.g. "PIX-2026-0001"
  invoiceSequence Int?    @unique
  status          String  @default("draft") // draft, issued, paid, overdue, cancelled, refunded
  invoiceKind     String  @default("final") @db.VarChar(24) // final | supplementary
  sourceKey       String? @unique @db.VarChar(64)

  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  serviceDate DateTime?

  // All amounts in cents
  subtotalCents Int   @default(0)
  taxRate       Float @default(19.0)
  taxCents      Int   @default(0)
  totalCents    Int   @default(0)

  // Structured line items
  lineItems       Json  @default("[]") // Array of LineItem objects
  billingSnapshot Json?
  sourceSnapshot  Json?

  // Style & config snapshot (for historical reference)
  styleId      String? // Style that was selected
  motifCount   Int?
  windowOption String? // clear | bright | auto

  // Payment
  stripePaymentIntentId String? @unique
  paymentMethod         String? // "stripe", "credit", "invoice", "trial"

  pdfObjectKey   String?
  pdfSha256      String?   @db.VarChar(64)
  pdfGeneratedAt DateTime?
  emailTo        String?
  emailCc        String?
  emailMessageId String?
  emailSentAt    DateTime?
  emailError     String?   @db.Text
  approvedAt     DateTime?
  approvedBy     String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([jobId])
  @@index([status])
}

model CreditBalance {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  balanceCents Int      @default(0) // Current credit balance in cents
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  amountCents Int // Positive = credit (top-up), Negative = debit (charge)
  type        String // topup, job_charge, refund, trial_credit, adjustment
  description String
  jobId       String? // Reference to job if applicable
  reference   String? // External ref (Stripe payment ID etc.)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// WEB-CONNECT SESSIONS — QR-Pairing zwischen Browser und iOS-App
// Quelle: PIXCAPTURE_IOS_BACKEND_CONTRACT_DEFINITIV_20260404.md
// -----------------------------------------------------------------------------

model WebConnectSession {
  id        String @id @default(cuid())
  sessionId String @unique // web_session_id aus QR (sess_xxx)
  status    String @default("pending") // pending, connected, approved, uploading, completed, expired
  command   String @default("wait") // wait, go

  uploadSessionId String? // UUID der UploadSession (NICHT identisch mit sessionId!)

  webUserId    String? // User-ID des Browsers
  mobileUserId String? // User-ID des Telefons

  projectId String?
  cust3     String? @db.VarChar(3)
  job5      String? @db.VarChar(5)

  totalFiles     Int?
  totalSizeBytes BigInt?

  stylePreset String?
  tasks       Json? // String[] — z.B. ["clear_window", "hdr_merge"]
  warnings    Json? // String[]
  manifest    Json? // Vollständiges Manifest vom Telefon

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([expiresAt])
  @@map("web_connect_sessions")
}
